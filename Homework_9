<body>
  <header>
    <h1>⚡ PokéVault Collector</h1>
    <a class="back-btn" href="/">← Back to Home</a>
  </header>

  <div class="concept">
    <strong>About this page:</strong> Instead of showing raw JSON or a plain table, this page turns live PokéAPI data into an interactive trading-card collection with visual power bars for HP, Attack, and Defense. My Flask backend fetches and caches the data for 5 minutes so visitors get fast responses, and users can search by name or filter cards by elemental type.
  </div>

  <div class="controls">
    <input type="text" id="search" placeholder="Search Pokémon by name..." />
    <select id="typeFilter">
      <option value="all">All Types</option>
    </select>
  </div>

  <div id="status">⏳ Loading live Pokémon cards from the server...</div>
  <div class="grid" id="grid"></div>

  <script>
    let allPokemon = [];
    const grid = document.getElementById("grid");
    const statusEl = document.getElementById("status");
    const searchInput = document.getElementById("search");
    const typeFilter = document.getElementById("typeFilter");

    function renderCards(list) {
      grid.innerHTML = "";
      if (list.length === 0) {
        statusEl.textContent = "No Pokémon match your search.";
        statusEl.style.display = "block";
        return;
      }
      statusEl.style.display = "none";
      list.forEach(p => {
        const card = document.createElement("div");
        card.className = "card";
        card.innerHTML = `
          <div class="card-top">
            <h2>${p.name}</h2>
            <span class="id-badge">#${String(p.id).padStart(3, "0")}</span>
          </div>
          <img src="${p.image}" alt="${p.name}" loading="lazy" />
          <div class="types">
            ${p.types.map(t => `<span class="type-pill">${t}</span>`).join("")}
          </div>
          <div class="stat-row">
            <span class="stat-label">HP</span>
            <div class="bar-bg"><div class="bar-fill" style="width:${Math.min(p.hp, 100)}%"></div></div>
            <span>${p.hp}</span>
          </div>
          <div class="stat-row">
            <span class="stat-label">ATK</span>
            <div class="bar-bg"><div class="bar-fill" style="width:${Math.min(p.attack, 100)}%"></div></div>
            <span>${p.attack}</span>
          </div>
          <div class="stat-row">
            <span class="stat-label">DEF</span>
            <div class="bar-bg"><div class="bar-fill" style="width:${Math.min(p.defense, 100)}%"></div></div>
            <span>${p.defense}</span>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    function applyFilters() {
      const q = searchInput.value.toLowerCase();
      const t = typeFilter.value;
      const filtered = allPokemon.filter(p =>
        p.name.toLowerCase().includes(q) && (t === "all" || p.types.includes(t))
      );
      renderCards(filtered);
    }

    async function loadData() {
      try {
        const res = await fetch("/api/pokemon");
        if (!res.ok) throw new Error("Server error");
        const data = await res.json();
        allPokemon = data.pokemon;

        const types = [...new Set(allPokemon.flatMap(p => p.types))].sort();
        types.forEach(t => {
          const opt = document.createElement("option");
          opt.value = t;
          opt.textContent = t.toUpperCase();
          typeFilter.appendChild(opt);
        });

        renderCards(allPokemon);
      } catch (err) {
        statusEl.className = "error";
        statusEl.textContent = "⚠️ Oops! Could not load live Pokémon data right now. Please check your internet connection and refresh.";
      }
    }

    searchInput.addEventListener("input", applyFilters);
    typeFilter.addEventListener("change", applyFilters);
    loadData();
  </script>
</body>
